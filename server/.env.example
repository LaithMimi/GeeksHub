# ── GeeksHub backend environment ───────────────────────────────────────────
# On Railway: set these in the service's "Variables" tab (never committed).
# Locally: copy this file to server/.env (loaded by database.py via load_dotenv).

# Neon Postgres connection string (keep ?sslmode=require for Neon).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# "production" makes auth cookies Secure + SameSite=None (required cross-site).
ENVIRONMENT=production

# Public URL of the Vercel frontend — used as the CORS allow-origin.
FRONTEND_URL=https://geeks-hub-v1.vercel.app

# Google Cloud Storage bucket holding uploaded materials.
BUCKET_NAME=your-gcs-bucket-name

# Gemini API key for the AI / RAG features (google-genai).
GEMINI_API_KEY=your-gemini-api-key

# ── GCP service-account credentials ────────────────────────────────────────
# Local dev: point to the key file (relative paths resolve against server/).
GOOGLE_APPLICATION_CREDENTIALS=gcp_key.json

# Railway: DO NOT use a file. Paste the FULL service-account JSON into a
# GCP_KEY_JSON variable instead — start.sh writes it to /tmp/gcp_key.json and
# sets GOOGLE_APPLICATION_CREDENTIALS for you.
# GCP_KEY_JSON={"type":"service_account","project_id":"...", ...}
